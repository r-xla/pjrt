# Anticonf (tm) script by Jeroen Ooms (2025)
# This script will query 'pkg-config' for the required cflags and ldflags.
# If pkg-config is unavailable or does not find the library, try setting
# INCLUDE_DIR and LIB_DIR manually via e.g:
# R CMD INSTALL --configure-vars='INCLUDE_DIR=/.../include LIB_DIR=/.../lib'

# Library settings
PKG_CONFIG_NAME="protobuf"
PKG_DEB_NAME="libprotobuf-dev"
PKG_RPM_NAME="protobuf-devel"
PKG_BREW_NAME="protobuf"
PKG_TEST_HEADER="<google/protobuf/message.h>"
PKG_LIBS="-lprotobuf"
PKG_CFLAGS=""

# Use pkg-config if available
pkg-config ${PKG_CONFIG_NAME} 2>/dev/null
if [ $? -eq 0 ]; then
  PKGCONFIG_CFLAGS=`pkg-config --cflags ${PKG_CONFIG_NAME}`
  PKGCONFIG_LIBS=`pkg-config --libs ${PKG_CONFIG_NAME}`
fi

# Note that cflags may be empty in case of success
if [ "$INCLUDE_DIR" ] || [ "$LIB_DIR" ]; then
  echo "Found INCLUDE_DIR and/or LIB_DIR!"
  PKG_CFLAGS="-I$INCLUDE_DIR $PKG_CFLAGS"
  PKG_LIBS="-L$LIB_DIR $PKG_LIBS"
elif [ "$PKGCONFIG_CFLAGS" ] || [ "$PKGCONFIG_LIBS" ]; then
  echo "Found pkg-config cflags and libs!"
  PKG_CFLAGS=${PKGCONFIG_CFLAGS}
  PKG_LIBS=${PKGCONFIG_LIBS}
elif [ `uname` = "Darwin" ]; then
  test ! "$CI" && brew --version 2>/dev/null
  if [ $? -eq 0 ]; then
    BREWDIR=`brew --prefix`
    PATH="$BREWDIR/bin:$PATH"
    PKG_CFLAGS="-I$BREWDIR/include"
    PKG_LIBS="-L$BREWDIR/lib $PKG_LIBS"
  else
    # autobrew provides pre-compiled static libraries for CRAN macOS builds
    curl -sfL "https://autobrew.github.io/scripts/protobuf" > autobrew
    . ./autobrew
    # Strip unused code from the static protobuf library to reduce binary size
    PKG_LIBS="$PKG_LIBS -Wl,-dead_strip -ffunction-sections -fdata-sections"
  fi
fi

# Find compiler
CXX=`${R_HOME}/bin/R CMD config CXX`
CXXFLAGS=`${R_HOME}/bin/R CMD config CXXFLAGS`
CPPFLAGS=`${R_HOME}/bin/R CMD config CPPFLAGS`

# For debugging
echo "Using PKG_CFLAGS=$PKG_CFLAGS"
echo "Using PKG_LIBS=$PKG_LIBS"

# Test configuration
echo "#include $PKG_TEST_HEADER" | ${CXX} ${CPPFLAGS} ${PKG_CFLAGS} ${CXXFLAGS} -E -xc++ - >/dev/null 2>configure.log

if [ $? -ne 0 ]; then
  echo "--------------------------- [ANTICONF] --------------------------------"
  echo "Configuration failed because $PKG_CONFIG_NAME was not found. Try installing:"
  echo " * deb: $PKG_DEB_NAME (Debian, Ubuntu, etc)"
  echo " * rpm: $PKG_RPM_NAME (Fedora, EPEL)"
  echo " * brew: $PKG_BREW_NAME (Mac)"
  echo "If $PKG_CONFIG_NAME is already installed, check that 'pkg-config' is in your"
  echo "PATH and PKG_CONFIG_PATH contains a $PKG_CONFIG_NAME.pc file. If pkg-config"
  echo "is unavailable you can set INCLUDE_DIR and LIB_DIR manually via:"
  echo "R CMD INSTALL --configure-vars='INCLUDE_DIR=... LIB_DIR=...'"
  echo "-------------------------- [ERROR MESSAGE] ---------------------------"
  cat configure.log
  echo "--------------------------------------------------------------------"
  exit 1
fi

# Fix for deprecated declarations
if pkg-config ${PKG_CONFIG_NAME} --atleast-version 3.6; then
PKG_CFLAGS="$PKG_CFLAGS -DUSENEWAPI"
fi

# The Catch-based C++ unit tests (src/test-*.cpp) pull the whole Catch header
# into the shipped library. Compile them out by default so end-user binaries
# stay lean; opt in by setting PJRT_BUILD_CPP_TESTS=1 at build time (the project
# CI does this so the tests still run there).
if [ "$PJRT_BUILD_CPP_TESTS" = "1" ]; then
  echo "Building with C++ unit tests ENABLED (PJRT_BUILD_CPP_TESTS=1)"
else
  echo "Building with C++ unit tests disabled (set PJRT_BUILD_CPP_TESTS=1 to enable)"
  PKG_CFLAGS="$PKG_CFLAGS -DTESTTHAT_DISABLED"
fi

# Look for 'protoc' compiler matching the library we found
PROTOC=""
if [ "$PKGCONFIG_CFLAGS" ] || [ "$PKGCONFIG_LIBS" ]; then
  PROTOC_PREFIX=`pkg-config --variable=exec_prefix ${PKG_CONFIG_NAME}`
  if [ -x "$PROTOC_PREFIX/bin/protoc" ]; then
    PROTOC="$PROTOC_PREFIX/bin/protoc"
  fi
fi
if [ -z "$PROTOC" ] && [ `command -v protoc` ]; then
  PROTOC=`command -v protoc`
fi
if [ -z "$PROTOC" ]; then
  echo "Failed to run protoc."
  echo "Please install the 'protobuf-compiler' package for your system."
  exit 1
fi
PROTOC_VERSION=`$PROTOC --version`
echo "Using ${PROTOC_VERSION} from ${PROTOC}"

# Generate C++ source files from .proto definitions
cd src;
mkdir -p proto;
$PROTOC -I "../inst/proto" --cpp_out="proto" --experimental_allow_proto3_optional $(find ../inst/proto -name "*.proto");

# copied from protolite:
# Suppress wanrings about pragmas in the autogenerated protobuf headers.
# Uwe + BDR have said this is OK and there is nothing we can do about this.
find ./ -type f -name "*.pb.h" -exec sed -i.bak "s@^[[:space:]]*#pragma@/*nowarn*/#pragma@g" "{}" \;
rm -f *.bak

# ---------------------------------------------------------------------------
# CUDA kernels
#
# src/cuda/*.cu holds device code pjrt ships itself, as opposed to the cuSOLVER
# routines it dlopens. Each file is compiled here, ahead of time, into a fatbin
# covering every GPU architecture the PJRT CUDA plugin supports, and embedded
# into the shared object as a byte array. None of this adds a link-time or
# run-time CUDA dependency -- src/cuda_kernels.h explains why.
#
# A missing nvcc is not an error: pjrt is installed on plenty of machines that
# will never see a GPU, and on those the kernels are simply left out. What that
# costs is visible from R as `pjrt_cuda_kernels_available()`.
#
# Overrides:
#   PJRT_NVCC             path to nvcc, skipping the search below
#   PJRT_CUDA_INCLUDE     directory holding cuda_runtime.h
#   PJRT_CUDA_R_PACKAGE   CUDA R package to take the toolkit from
#   PJRT_CUDA_SM_ARCHS    architectures to emit cubins for
#   PJRT_CUDA_PTX_ARCH    architecture to emit PTX for

CUDA_R_PACKAGE="${PJRT_CUDA_R_PACKAGE:-cuda12.8}"

# Architectures to precompile for, copied from JAX's .bazelrc
# (HERMETIC_CUDA_COMPUTE_CAPABILITIES for CUDA 12). One cubin per GPU
# generation suffices because cubins are forward compatible across minor
# versions within a generation -- an sm_80 cubin runs on sm_86 and sm_89 -- and
# the PTX entry below covers anything newer than the whole list, at the cost of
# a JIT on first load. Together these reach every device the PJRT CUDA plugin
# itself carries code for (sm_50 through sm_120).
SM_ARCHS="${PJRT_CUDA_SM_ARCHS:-50 60 70 80 90 100 101}"
PTX_ARCH="${PJRT_CUDA_PTX_ARCH:-120}"

# mlverse/cudatoolkit's cuda12.8 and friends ship a toolkit without needing a
# system CUDA install, so prefer whichever one this R library has.
cuda_pkg_path() {
  "${R_HOME}/bin/Rscript" --vanilla -e "
    pkg <- '${CUDA_R_PACKAGE}'
    if (requireNamespace(pkg, quietly = TRUE)) {
      p <- try(getExportedValue(pkg, '$1')('$2'), silent = TRUE)
      if (!inherits(p, 'try-error')) cat(p)
    }" 2>/dev/null
}

NVCC="$PJRT_NVCC"
if [ -z "$NVCC" ]; then
  CANDIDATE=`cuda_pkg_path bin_path nvcc`
  if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE/nvcc" ]; then
    NVCC="$CANDIDATE/nvcc"
  else
    for CUDA_ROOT in "$CUDA_HOME" "$CUDA_PATH" /usr/local/cuda; do
      if [ -n "$CUDA_ROOT" ] && [ -x "$CUDA_ROOT/bin/nvcc" ]; then
        NVCC="$CUDA_ROOT/bin/nvcc"
        break
      fi
    done
    if [ -z "$NVCC" ]; then
      NVCC=`command -v nvcc 2>/dev/null`
    fi
  fi
fi

# nvcc implicitly includes cuda_runtime.h. A toolkit install has it next to the
# compiler and needs no help; the R packages split it into a separate component
# directory, so point at that when we are using one.
CUDA_INC="$PJRT_CUDA_INCLUDE"
if [ -z "$CUDA_INC" ]; then
  CANDIDATE=`cuda_pkg_path include_path runtime`
  if [ -n "$CANDIDATE" ] && [ -f "$CANDIDATE/cuda_runtime.h" ]; then
    CUDA_INC="$CANDIDATE"
  else
    for CUDA_ROOT in "$CUDA_HOME" "$CUDA_PATH" /usr/local/cuda; do
      if [ -n "$CUDA_ROOT" ] && [ -f "$CUDA_ROOT/include/cuda_runtime.h" ]; then
        CUDA_INC="$CUDA_ROOT/include"
        break
      fi
    done
  fi
fi

# There is no CUDA PJRT plugin for Windows (see plugin_url() in R/plugin.R) and
# src/cuda_kernels.cpp compiles to nothing there, so device code would be dead
# weight in the DLL even if a Windows nvcc turned up.
case `uname -s` in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) NVCC="" ;;
esac

FATBINS=""
if [ -n "$NVCC" ] && [ -d cuda ]; then
  echo "Building CUDA kernels with $NVCC"

  # Drop any architecture this nvcc is too old to know about, rather than
  # failing the whole build over it.
  KNOWN_ARCHS=`"$NVCC" --list-gpu-arch 2>/dev/null | sed 's/compute_//'`
  GENCODE=""
  for ARCH in $SM_ARCHS; do
    if echo "$KNOWN_ARCHS" | grep -qx "$ARCH"; then
      GENCODE="$GENCODE -gencode arch=compute_$ARCH,code=sm_$ARCH"
    fi
  done
  if ! echo "$KNOWN_ARCHS" | grep -qx "$PTX_ARCH"; then
    PTX_ARCH=`echo "$KNOWN_ARCHS" | tail -1`
  fi
  if [ -n "$PTX_ARCH" ]; then
    # Cubin *and* PTX for the newest architecture we can name. Spelled as two
    # -gencode flags rather than nvcc's code=[a,b] shorthand, whose brackets
    # the shell would try to glob.
    GENCODE="$GENCODE -gencode arch=compute_$PTX_ARCH,code=sm_$PTX_ARCH"
    GENCODE="$GENCODE -gencode arch=compute_$PTX_ARCH,code=compute_$PTX_ARCH"
  fi

  NVCC_FLAGS="-std=c++17 -O2 -Wno-deprecated-gpu-targets"
  if [ -n "$CUDA_INC" ]; then
    NVCC_FLAGS="$NVCC_FLAGS -I$CUDA_INC"
  fi

  for CU_FILE in cuda/*.cu; do
    [ -f "$CU_FILE" ] || continue
    FATBIN=`basename "$CU_FILE" .cu`.fatbin
    if "$NVCC" $NVCC_FLAGS $GENCODE -fatbin "$CU_FILE" -o "$FATBIN" 2>&1; then
      FATBINS="$FATBINS $FATBIN"
    else
      # Partial device code would be worse than none: a handler would find
      # some kernels and not others. Drop the lot and carry on without.
      echo "WARNING: $CU_FILE failed to compile; building pjrt without CUDA kernels."
      rm -f $FATBINS "$FATBIN"
      FATBINS=""
      break
    fi
  done
else
  echo "No nvcc found; building pjrt without CUDA kernels."
fi

"${R_HOME}/bin/Rscript" --vanilla ../tools/embed_fatbin.R cuda_fatbin.cpp $FATBINS

PB_SRC=$(echo $(find proto -type f -name "*.pb.cc" -print))
CPP_SRC=$(echo $(find *.cpp -print))
CRC_SRC=$(echo $(find . -type f -name "*.c" -print))

sed -e "s|@pbsrc@|$PB_SRC|" -e "s|@cppsrc@|$CPP_SRC|" -e "s|@csrc@|$CRC_SRC|" \
    -e "s|@cflags@|$PKG_CFLAGS|" -e "s|@libs@|$PKG_LIBS|" -e "s|CXX11|${CXX_STD}|" \
    Makevars.in > Makevars

exit 0;
