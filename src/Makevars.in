CXX_STD=CXX20

# The vendored half.hpp's _h literal is unused and trips clang >= 21's
# -Wdeprecated-literal-operator, so it is compiled out.
PKG_CPPFLAGS=@cflags@ -Iproto -I$(R_PACKAGE_DIR)/include -I../inst/include -DHALF_ENABLE_CPP11_USER_LITERALS=0
PKG_CXXFLAGS=$(C_VISIBILITY)
PKG_LIBS=@libs@ $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

CPP_SOURCES=@cppsrc@
CC_SOURCES=@pbsrc@
C_SOURCES=@csrc@

OBJECTS=$(CPP_SOURCES:.cpp=.o) $(CC_SOURCES:.cc=.o) $(C_SOURCES:.c=.o)
